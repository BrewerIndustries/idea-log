[Unit]
Description=Idea Log (Next.js)
After=network.target

[Service]
Type=simple
User=dan
WorkingDirectory=/opt/idea-log
Environment=NODE_ENV=production
Environment=PORT=4660
# Real secrets (JARVIS_TOKEN) live in /opt/idea-log/.env:
EnvironmentFile=/opt/idea-log/.env
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
