# Shared secret required to POST/PATCH/DELETE ideas via the API.
# Generate one with:  openssl rand -hex 24
JARVIS_TOKEN=change-me-to-a-long-random-string

# Where the SQLite file lives (optional; defaults to ./data/ideas.db)
# IDEA_LOG_DB_PATH=/var/lib/idea-log/ideas.db

# Set to "dev" on the DEV deployment to show the amber non-prod banner.
# Leave UNSET on prod. (Prod is also hard-guarded by its :4660 port.)
# JARVIS_ENV=dev

# --- File attachments (Cloudflare R2) ---------------------------------------
# Optional. Set all four to enable image/file/note attachments on ideas. When
# unset, the app runs fine but uploads return "storage not configured".
# Create an R2 bucket + an API token (Object Read & Write) in the Cloudflare
# dashboard. Object keys are auto-prefixed dev/ vs prod/ so both envs can share
# one bucket safely.
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=r2-token-access-key-id
# R2_SECRET_ACCESS_KEY=r2-token-secret-access-key
# R2_BUCKET=idea-log
