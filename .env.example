# Shared secret required to POST/PATCH/DELETE ideas via the API.
# Generate one with:  openssl rand -hex 24
JARVIS_TOKEN=change-me-to-a-long-random-string

# Where the SQLite file lives (optional; defaults to ./data/ideas.db)
# IDEA_LOG_DB_PATH=/var/lib/idea-log/ideas.db

# Set to "dev" on the DEV deployment to show the amber non-prod banner.
# Leave UNSET on prod. (Prod is also hard-guarded by its :4660 port.)
# JARVIS_ENV=dev
